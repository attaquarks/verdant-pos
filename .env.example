# Public project URL and publishable key are safe for browser use.
# Do not use a Supabase service-role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional for private product photos on hosted Supabase. These are server-only.
# Use the project's legacy anonymous key, never a service-role or secret key.
SUPABASE_STORAGE_LEGACY_ANON_KEY=your-legacy-anon-key
SUPABASE_STORAGE_S3_REGION=your-project-region

# Canonical public application URL. Used to validate mutation origins.
# Use your HTTPS production domain when deployed.
APP_URL=http://localhost:3000

# Optional: HTTPS Supabase Data API concurrency checks (never required by the app).
# Set test credentials through your local secure environment; never commit them.
# See docs/testing.md for the real-database concurrency verification procedure.
